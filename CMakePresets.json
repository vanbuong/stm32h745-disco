{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 22, "patch": 0 },
  "configurePresets": [
    {
      "name": "default",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "toolchainFile": "${sourceDir}/gcc-arm-none-eabi.cmake",
      "cacheVariables": {
      }
    },
    {
      "name": "Debug",
      "inherits": "default",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "Release",
      "inherits": "default",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "m7-debug",
      "displayName": "M7 only",
      "inherits": "default",
      "binaryDir": "${sourceDir}/build-m7",
      "cacheVariables": {
        "CORE": "M7",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "m4-debug",
      "displayName": "M4 only",
      "inherits": "default",
      "binaryDir": "${sourceDir}/build-m4",
      "cacheVariables": {
        "CORE": "M4",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "host-tests",
      "displayName": "Host unit tests",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build-host",
      "environment": { "CC": "gcc" },
      "cacheVariables": {
        "HOST_TESTS": "ON",
        "COVERAGE": "ON",
        "CMAKE_C_COMPILER": "gcc"
      }
    },
    {
      "name": "host-sim",
      "displayName": "Host LVGL SDL simulator",
      "description": "PC window (Ubuntu/Windows). Requires SDL2 (apt libsdl2-dev or FetchContent).",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-sim",
      "cacheVariables": {
        "HOST_SIM": "ON",
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    }
  ],
  "buildPresets": [
    { "name": "Debug", "configurePreset": "Debug" },
    { "name": "Release", "configurePreset": "Release" },
    { "name": "host-tests", "configurePreset": "host-tests" },
    { "name": "host-sim", "configurePreset": "host-sim" },
    { "name": "m7-debug", "configurePreset": "m7-debug" },
    { "name": "m4-debug", "configurePreset": "m4-debug" }
  ]
}
