{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "CM7_Debug",
      "type": "stlinkgdbtarget",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "preBuild": "${command:st-stm32-ide-debug-launch.build}",
      "runEntry": "main",
      "deviceName": "STM32H745XIH6",
      "deviceCore": "Cortex-M7",
      "serverShared": true,
      "serverHaltAllCores": true,
      "svdPath": "${workspaceFolder}/third_party/cmsis-svd/STM32H745_CM7.svd",
      "imagesAndSymbols": [
        {
          "imageFileName": "${workspaceFolder}/CM4/build/firmware-m4.elf"
        },
        {
          "imageFileName": "${workspaceFolder}/CM7/build/firmware-m7.elf"
        }
      ],
      "verbose": false
    },
    {
      "name": "CM4_Debug",
      "type": "stlinkgdbtarget",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runEntry": "main",
      "deviceName": "STM32H745XIH6",
      "deviceCore": "Cortex-M4",
      "serverShared": true,
      "serverApID": "3",
      "serverPort": "61239",
      "serverReset": "None",
      "svdPath": "${workspaceFolder}/third_party/cmsis-svd/STM32H745_CM4.svd",
      "imagesAndSymbols": [
        {
          "symbolFileName": "${workspaceFolder}/CM4/build/firmware-m4.elf"
        }
      ],
      "verbose": false
    }
  ],
  "compounds": [
    {
      "name": "DualCore_Debug",
      "configurations": ["CM7_Debug", "CM4_Debug"],
      "stopAll": true
    }
  ]
}
